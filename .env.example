POSTGRES_DB=mkvip
POSTGRES_USER=mkvip
POSTGRES_PASSWORD=mkvip
MKVIP_DATABASE_URL=postgresql+asyncpg://mkvip:mkvip@db:5432/mkvip
MKVIP_ALLOWED_ORIGINS=["http://localhost:5173"]
MKVIP_SESSION_COOKIE_SECURE=false
MKVIP_SESSION_DURATION_DAYS=30
MKVIP_LOGIN_MAX_ATTEMPTS=5
MKVIP_LOGIN_LOCK_MINUTES=15
MKVIP_AI_DAILY_QUOTA=20
MKVIP_AI_CACHE_TTL_SECONDS=3600
MKVIP_YAHOO_MAX_CONCURRENCY=8
MKVIP_YAHOO_RESPONSE_TIMEOUT_SECONDS=10
MKVIP_YAHOO_IMPORT_TIMEOUT_SECONDS=30
MKVIP_YAHOO_IMPORTS_PER_USER=1
OPENAI_API_KEY=
MKVIP_OPENAI_MODEL=gpt-5.6-sol
