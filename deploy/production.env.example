COMPOSE_PROJECT_NAME=mkvip-production
MKVIP_IMAGE_TAG=staging

# DNS and automatic HTTPS
MKVIP_DOMAIN=invest.example.com
ACME_EMAIL=ops@example.com

# PostgreSQL
POSTGRES_DB=mkvip
POSTGRES_USER=mkvip
POSTGRES_PASSWORD_FILE=./deploy/secrets/postgres_password
MKVIP_DATABASE_URL_FILE=./deploy/secrets/database_url

# Application secrets
OPENAI_API_KEY_FILE=./deploy/secrets/openai_api_key
MKVIP_AUTH_EMAIL_HASH_SECRET_FILE=./deploy/secrets/auth_email_hash_secret
MKVIP_MFA_ENCRYPTION_KEY_FILE=./deploy/secrets/mfa_encryption_key

# Transactional email
MKVIP_SMTP_HOST=smtp.example.com
MKVIP_SMTP_PORT=587
MKVIP_SMTP_FROM=MK-VIP <no-reply@example.com>
MKVIP_SMTP_USERNAME=mkvip
MKVIP_SMTP_PASSWORD_FILE=./deploy/secrets/smtp_password

# Optional tuning
MKVIP_LOG_LEVEL=INFO
MKVIP_SESSION_DURATION_DAYS=30
MKVIP_LOGIN_IP_MAX_PER_WINDOW=20
MKVIP_LOGIN_ACCOUNT_MAX_PER_WINDOW=10
MKVIP_AI_DAILY_QUOTA=20
MKVIP_YAHOO_MAX_CONCURRENCY=8
